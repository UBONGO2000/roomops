# Copy this file to .env.prod and fill in real values. Never commit .env.prod.

# --- PostgreSQL ---
POSTGRES_DB=roomops
POSTGRES_USER=roomops_user
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- JWT (HMAC-SHA256 key, base64-encoded, at least 32 random bytes) ---
# Generate one with: openssl rand -base64 32
# Never reuse the default committed in backend/src/main/resources/application.properties —
# that one is public (dev/CI only) and signing tokens with it in production is a full auth bypass.
JWT_SECRET=change-me-generate-a-real-secret
JWT_ACCESS_TOKEN_TTL_MS=900000
JWT_REFRESH_TOKEN_TTL_MS=604800000

# --- Frontend ---
# Host port the nginx frontend is published on. The backend has no host port: it is reachable
# only from the frontend's nginx, through the compose's internal network (see nginx.conf).
FRONTEND_PORT=80

# --- Images ---
# Tag to deploy. A commit SHA pins a specific build (used for rollback); "latest" tracks main.
IMAGE_TAG=latest
